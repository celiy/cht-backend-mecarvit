NODE_ENV=development
# Web/dev: 3001. No Electron o processo é iniciado com PORT=0 (porta livre do SO).
PORT=3001
PORT_SCAN_LIMIT=20
HOST=127.0.0.1

EMPRESAS_DIR=./data/empresas

JWT_SECRET=change-me-please
# Em produção (`NODE_ENV=production`) este valor de exemplo é recusado. Defina um segredo único.
JWT_EXPIRES_IN=7d

# Desktop (instalador Windows / primeiro uso): login do dono do sistema.
# A senha nunca fica em texto; o backend grava só SYSTEM_OWNER_PASSWORD_HASH.
# SYSTEM_OWNER_LOGIN=
# SYSTEM_OWNER_PASSWORD_HASH=

CORS_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5172,http://127.0.0.1:5173,http://127.0.0.1:5174
